---
 mythtv/mythplugins/mythweb/includes/db_update.php | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mythtv/mythplugins/mythweb/includes/db_update.php b/mythtv/mythplugins/mythweb/includes/db_update.php
index 63ece990..e970a9df 100644
--- a/mythtv/mythplugins/mythweb/includes/db_update.php
+++ b/mythtv/mythplugins/mythweb/includes/db_update.php
@@ -61,7 +61,7 @@
                 setting('WebDBSchemaVer',    null, ++$db_vers, false);
 
             case 4:
-                setting('mythweb_use_cdn', null, true);
+                setting('mythweb_use_cdn', null, false);
                 setting('WebDBSchemaVer',    null, ++$db_vers, false);
 				
         // All other numbers should run their changes sequentially
